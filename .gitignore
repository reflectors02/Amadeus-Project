```gitignore
# =====================
# Python / Conda
# =====================
__pycache__/
*.pyc
*.pyo
*.pyd

.env
*.env
.venv/
venv/

# =====================
# Amadeus backend runtime data
# =====================
backend/__pycache__/
backend/unused_files/

# Secrets
backend/data/api_key.txt

# Persistent / generated runtime data
backend/data/memory.db
backend/data/memory.json
backend/data/conversation_settings.json
backend/generated/
backend/ttsout/generated.wav

# =====================
# Frontend / Node
# =====================
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Legacy WebUI folder name, if still present locally
Amadeus-WebUI/node_modules/
Amadeus-WebUI/dist/
Amadeus-WebUI/.vite/

# =====================
# Logs
# =====================
log_*.txt
*.log

# =====================
# GPT-SoVITS
# Large external dependency cloned separately
# =====================
GPT-SoVITS/

# =====================
# IDE / Editor
# =====================
.vscode/
.idea/

# =====================
# OS junk
# =====================
.DS_Store
Thumbs.db

# =====================
# Local-only files
# =====================
UsefulInfo/
.runtime/
```
